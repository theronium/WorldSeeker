class_name NameGenerator
# 探索者の自動命名用の名前辞書。design.md 8.1の方針(マップ等のコンテンツは実行時にAPI生成せず、
# 開発時にオフラインで用意する)に合わせ、実行時のプログラム生成ではなく事前生成した
# 静的なリストから抽選する。血筋(recruitment.gdのBLOODLINES)ごとに雰囲気を変えてある。

const NAMES_BY_BLOODLINE := {
	"平民": [
		"トム", "ハンス", "グレタ", "マルタ", "ヴィル", "アニャ", "ロブ", "ネル",
		"オズ", "ミラ", "ダン", "ベス", "ジャック", "ケイト", "サム", "ルーシー",
		"フィン", "ノラ", "トビー", "エマ", "ウィル", "アリー", "ベン", "ソフィ",
	],
	"旧家の血筋": [
		"アレクサンダー", "イザベラ", "セバスチャン", "ヴィクトリア", "レジナルド", "エレノア", "フェルディナンド", "ロザリンド",
		"オーガスティン", "ジュリエッタ", "バーソロミュー", "セレスティア", "エドモンド", "マティルダ", "レオポルド", "アデライン",
		"コンスタンス", "ジェラルディン", "フランシスカ", "ヴァレンティン", "オクタヴィア", "ペルシヴァル", "ロザムンド", "アーチボルド",
	],
	"森人の血": [
		"エラニス", "シルヴァンドリル", "フィアレス", "リアンドラ", "タリシエル", "イルヴェニア", "アエリンドラ", "ケレヴォン",
		"ミスラニエル", "オルシフェル", "ヴァレシア", "セレフィン", "ナイアランス", "エルロシエル", "フィンドール", "アラウェン",
		"シルフィエル", "タウリエル", "ロスシエル", "エヴァンシア", "キーラン", "レゴラシエル", "アリアンロッド", "セラフィエル",
	],
	"王家の落胤": [
		"カシミール", "テオドラ", "マクシミリアン", "セラフィナ", "アウグスト", "イザドラ", "レオンハルト", "オーロリア",
		"フリードリヒ", "ヴィオランテ", "コンラート", "エリザヴェータ", "ルドヴィコ", "アナスタシア", "ジギスムント", "カタリナ",
